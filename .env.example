# Copy to .env for local development. Never commit .env.
ENVIRONMENT=development

# Supabase -> Project Settings -> Database -> Connection string -> "Session pooler" (port 5432).
# Leave unset to use a local SQLite file (oryne-dev.db).
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase -> Project Settings -> API. Tokens are verified via JWKS from this URL.
SUPABASE_URL=https://<project-ref>.supabase.co
# Only for legacy projects that still sign tokens with the shared HS256 JWT secret:
# SUPABASE_JWT_SECRET=

# Origins allowed to call the API from a browser (the dashboard), comma-separated.
ALLOWED_ORIGINS=http://localhost:5180

# Public URL of this API (used for Daraja callback URLs from phase 2).
PUBLIC_BASE_URL=http://localhost:8000

# Long random secret mixed into API-key hashes. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never change it in production after keys are issued (all keys would stop working).
API_KEY_PEPPER=dev-only-pepper-change-me
