# Only three settings are needed on Render. Locally, all are optional (SQLite + dev defaults).

# Supabase -> Connect -> "Session pooler" connection string.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase -> Project Settings -> API -> Project URL.
# SUPABASE_URL=https://<project-ref>.supabase.co

# Long random secret (32+ chars). Never change it once API keys exist.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# API_KEY_PEPPER=

# Optional (comma-separated). Defaults to https://panel.oryne.org,http://localhost:5180.
# ALLOWED_ORIGINS=https://dashboard.example.com

# Needed to create merchant logins when approving access requests.
# Supabase -> Project Settings -> API Keys -> Secret key (sb_secret_...). Server-only, never in the dashboard.
# SUPABASE_SECRET_KEY=

# Optional: email login details with Resend (https://resend.com). Without it, copy the password from the dashboard.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Oryne <noreply@oryne.org>   (domain must be verified in Resend)
# Celcom Africa SMS: payment alerts to merchants' own phones (optional)
# CELCOM_API_KEY=...
# CELCOM_PARTNER_ID=...
# CELCOM_SHORTCODE=...   (your approved sender ID)
# DASHBOARD_URL=https://panel.oryne.org
