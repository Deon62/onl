# Only three settings are needed on Render. Locally, all are optional (SQLite + dev defaults).

# Supabase -> Connect -> "Session pooler" connection string.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase -> Project Settings -> API -> Project URL.
# SUPABASE_URL=https://<project-ref>.supabase.co

# Long random secret (32+ chars). Never change it once API keys exist.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# API_KEY_PEPPER=

# Optional (comma-separated). Defaults to https://panel.oryne.org,http://localhost:5180.
# ALLOWED_ORIGINS=https://dashboard.example.com
